{
  "schemaVersion": "2.0.0",
  "modules": [
    {
      "kind": "javascript-module",
      "path": "dist/index.js",
      "declarations": [
        {
          "kind": "class",
          "name": "FlipperWidget",
          "tagName": "flipper-widget",
          "customElement": true,
          "description": "Drop-in flipper.family coin flip. The wallet comes from the host: set `provider` or `walletClient`.",
          "superclass": {
            "name": "LitElement",
            "package": "lit"
          },
          "attributes": [
            {
              "name": "chain-id",
              "fieldName": "chainId",
              "type": {
                "text": "number | \"robinhood\" | \"local\""
              },
              "description": "Chain to flip on (default: the manifest's, 4663 Robinhood Chain on flipper.family)"
            },
            {
              "name": "rpc-url",
              "fieldName": "rpcUrl",
              "type": {
                "text": "string"
              },
              "description": "Read RPC (default: the chain's public RPC)"
            },
            {
              "name": "api-url",
              "fieldName": "apiUrl",
              "type": {
                "text": "string | null"
              },
              "description": "flipper API for the token list and logos; \"none\" for on-chain only"
            },
            {
              "name": "deployment-url",
              "fieldName": "deploymentUrl",
              "type": {
                "text": "string | null"
              },
              "description": "Deployment manifest (default https://flipper.family/embed/deployment.json)"
            },
            {
              "name": "addresses",
              "fieldName": "addresses",
              "type": {
                "text": "object (JSON)"
              },
              "description": "Contract overrides: house, lens, flipper, v4Adapter, v3Adapter, weth…"
            },
            {
              "name": "token",
              "fieldName": "token",
              "type": {
                "text": "string"
              },
              "description": "Token selected at start: an address or \"ETH\" (default $FLIPPER)"
            },
            {
              "name": "tokens",
              "fieldName": "tokens",
              "type": {
                "text": "string[] (comma list)"
              },
              "description": "Allowlist of tokens the picker offers"
            },
            {
              "name": "mode",
              "fieldName": "mode",
              "type": {
                "text": "\"picker\" | \"single\""
              },
              "description": "picker (default): the user chooses the token. single: one fixed token (token required), no picker"
            },
            {
              "name": "hide-picker",
              "fieldName": "hidePicker",
              "type": {
                "text": "boolean"
              },
              "description": "Deprecated: use mode=\"single\""
            },
            {
              "name": "fit",
              "fieldName": "fit",
              "type": {
                "text": "\"auto\" | \"fill\""
              },
              "description": "auto (default): height follows the content. fill: take the element's full height"
            },
            {
              "name": "size",
              "fieldName": "size",
              "type": {
                "text": "\"sm\" | \"md\" | \"lg\" | \"auto\""
              },
              "description": "Scale on top of the fluid layout"
            },
            {
              "name": "details",
              "fieldName": "details",
              "type": {
                "text": "boolean"
              },
              "description": "Show the win chance / payout / fee line under the button (default off)"
            },
            {
              "name": "tagline",
              "fieldName": "tagline",
              "type": {
                "text": "string | boolean"
              },
              "description": "Idle headline under the coin: true = the built-in one, a string = your own (default none)"
            },
            {
              "name": "eth",
              "fieldName": "eth",
              "type": {
                "text": "boolean"
              },
              "description": "Offer native ETH, flipped as WETH (default true)"
            },
            {
              "name": "listing",
              "fieldName": "listing",
              "type": {
                "text": "boolean"
              },
              "description": "Permissionless listing of eligible tokens (default true)"
            },
            {
              "name": "min-amount",
              "fieldName": "minAmount",
              "type": {
                "text": "string"
              },
              "description": "Minimum stake in token units"
            },
            {
              "name": "max-amount",
              "fieldName": "maxAmount",
              "type": {
                "text": "string"
              },
              "description": "Maximum stake in token units"
            },
            {
              "name": "approval",
              "fieldName": "approval",
              "type": {
                "text": "\"max\" | \"exact\""
              },
              "description": "Allowance to request when short (default max)"
            },
            {
              "name": "variant",
              "fieldName": "variant",
              "type": {
                "text": "\"card\" | \"compact\" | \"button\""
              },
              "description": "Layout (default card)"
            },
            {
              "name": "theme",
              "fieldName": "theme",
              "type": {
                "text": "\"light\" | \"dark\" | \"auto\" | FlipperTheme (JSON)"
              },
              "description": "Colour mode or a full theme object"
            },
            {
              "name": "accent",
              "fieldName": "accent",
              "type": {
                "text": "string"
              },
              "description": "Accent colour"
            },
            {
              "name": "radius",
              "fieldName": "radius",
              "type": {
                "text": "number"
              },
              "description": "Card corner radius in px"
            },
            {
              "name": "branding",
              "fieldName": "branding",
              "type": {
                "text": "boolean"
              },
              "description": "false removes the flipper.family marks"
            },
            {
              "name": "brand-name",
              "fieldName": "brandName",
              "type": {
                "text": "string"
              },
              "description": "Header name"
            },
            {
              "name": "brand-logo",
              "fieldName": "brandLogo",
              "type": {
                "text": "string"
              },
              "description": "Header logo URL"
            },
            {
              "name": "coin-image",
              "fieldName": "coinImage",
              "type": {
                "text": "string"
              },
              "description": "Heads face image URL"
            },
            {
              "name": "coin-image-tails",
              "fieldName": "coinImageTails",
              "type": {
                "text": "string"
              },
              "description": "Tails face image URL"
            },
            {
              "name": "button-label",
              "fieldName": "buttonLabel",
              "type": {
                "text": "string"
              },
              "description": "Trigger label (variant=\"button\")"
            },
            {
              "name": "locale",
              "fieldName": "locale",
              "type": {
                "text": "string"
              },
              "description": "Built-in strings: en, es"
            },
            {
              "name": "reduced-motion",
              "fieldName": "reducedMotion",
              "type": {
                "text": "boolean"
              },
              "description": "Force reduced motion on or off"
            },
            {
              "name": "partner",
              "fieldName": "partner",
              "type": {
                "text": "string"
              },
              "description": "Partner id: echoed in events, sent as X-Flipper-Partner; a registered code (1-32 of a-z 0-9 _ -) is also attributed onchain (ERC-8021 suffix on every flip)"
            }
          ],
