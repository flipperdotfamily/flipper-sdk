{
  "name": "@flipperdotfamily/react",
  "version": "0.1.0",
  "description": "React components and hooks for flipper.family: the drop-in <FlipperWidget /> (SSR-safe, bring your own wallet) and a headless useFlipperClient hook.",
  "keywords": [
    "flipper",
    "coin flip",
    "react",
    "nextjs",
    "widget",
    "web3",
    "wagmi",
    "viem",
    "robinhood chain"
  ],
  "license": "MIT",
  "author": "flipper.family <dev@flipper.family>",
  "homepage": "https://flipper.family/docs/integrate#react",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flipperdotfamily/flipper-sdk.git",
    "directory": "react"
  },
  "bugs": {
    "url": "https://github.com/flipperdotfamily/flipper-sdk/issues",
    "email": "dev@flipper.family"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@flipperdotfamily/sdk": "workspace:^",
    "@flipperdotfamily/widget": "workspace:^",
    "viem": "^2.21.56"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
