{
  "name": "@flipperdotfamily/angular",
  "version": "0.1.0",
  "description": "Angular standalone component for flipper.family: the drop-in <flipper-widget> coin flip with typed inputs and outputs (bring your own wallet). Angular 17+.",
  "keywords": [
    "flipper",
    "coin flip",
    "angular",
    "standalone component",
    "widget",
    "web3",
    "robinhood chain"
  ],
  "license": "MIT",
  "author": "flipper.family <dev@flipper.family>",
  "homepage": "https://flipper.family/docs/integrate#angular",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flipperdotfamily/flipper-sdk.git",
    "directory": "angular"
  },
  "bugs": {
    "url": "https://github.com/flipperdotfamily/flipper-sdk/issues",
    "email": "dev@flipper.family"
  },
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "./dist/flipper-widget.component.js"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && ngc -p tsconfig.lib.json",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@flipperdotfamily/widget": "workspace:^",
    "tslib": "^2.6.0"
  },
  "peerDependencies": {
    "@angular/core": ">=17.0.0"
  },
  "devDependencies": {
    "@angular/compiler": "~21.2.0",
    "@angular/compiler-cli": "~21.2.0",
    "@angular/core": "~21.2.0",
    "rxjs": "^7.8.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
